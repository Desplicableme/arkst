[Desktop Entry]
Name=Aura
GenericName=App Store
Comment=Mac-inspired modern App Store tailored for Hyprland on Arch Linux
Exec=aura %U
Icon=io.github.aura
Terminal=false
Type=Application
Categories=System;PackageManager;Settings;Utility;
Keywords=pacman;paru;aur;deb;hyprland;store;apps;install;software;docker;flatpak;
StartupNotify=true
StartupWMClass=io.github.aura
MimeType=application/vnd.debian.binary-package;application/x-deb;x-scheme-handler/appstream;x-scheme-handler/aura;
Actions=Updates;DebInstaller;HyprlandHub;Docker;Installed;

[Desktop Action Updates]
Name=Check Updates
Exec=aura --updates

[Desktop Action DebInstaller]
Name=.deb Package Installer
Exec=aura --deb

[Desktop Action HyprlandHub]
Name=Hyprland Hub
Exec=aura --hyprland

[Desktop Action Docker]
Name=Docker Applications
Exec=aura --docker

[Desktop Action Installed]
Name=Installed Applications
Exec=aura --installed
